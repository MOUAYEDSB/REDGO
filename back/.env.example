SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Set this only in the local, git-ignored back/.env file.
# Never expose this key to a frontend or API response.
SUPABASE_SECRET_KEY=

# Supabase Auth Send Email Hook. Configure the same webhook secret in
# Supabase Dashboard > Authentication > Hooks.
AUTH_EMAIL_HOOK_SECRET=v1,whsec_replace_me

# SMTP credentials for Nodemailer. Keep these server-side only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="REDGO <no-reply@example.com>"

# Optional publicly reachable REDGO logo image for email templates.
REDGO_EMAIL_LOGO_URL=https://example.com/redgo-logo.png
PORT=3000
