{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@redgo/shared": ["./packages/shared/src/index.ts"],
      "@redgo/validation": ["./packages/validation/src/index.ts"],
      "@redgo/config": ["./packages/config/src/index.ts"],
      "@redgo/theme": ["./packages/theme/src/index.ts"]
    }
  }
}
